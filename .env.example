# ── Django Core ────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Relational Database (SQLite in dev, Postgres in prod) ──────────────────────
# Leave blank to use SQLite (default for dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For Postgres, uncomment and fill:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smartserve_db
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS (origins allowed to call this API) ─────────────────────────────────────
# Must match wherever the frontend is served. Comma-separated, no trailing slash.
# Local dev: the Vite dev server. Production: your Vercel deployment URL(s),
# e.g. https://smartserve-ai.vercel.app — set this on Render, not here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# Atlas:     mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smartserve_db

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Use 'console' in dev (prints to terminal). Change to 'smtp' for prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── AI / LLM Assistant ─────────────────────────────────────────────────────────
# Set to 'openai', 'anthropic', or leave blank to use stats-based fallback
LLM_PROVIDER=
LLM_API_KEY=

# ── File Storage (local dev; switch to S3 for prod) ───────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media/

# ── Security (production — set these on Render, not here) ──────────────────────
# ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com
# DEBUG=False automatically turns on SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE,
# and CSRF_COOKIE_SECURE (see smartserve/settings.py) — no separate flags needed.
