# Base URL of the Django REST API. No trailing slash.
#
# Local dev: matches `python manage.py runserver`.
# Production (Vercel): set this in the Vercel project's Environment Variables
# (Settings → Environment Variables), NOT in this file — Vercel doesn't read
# .env files from the repo. Point it at your deployed backend, e.g.
# https://smartserve-api.onrender.com/api — and that exact Vercel domain must
# be listed in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_URL=http://127.0.0.1:8000/api
