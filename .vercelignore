# The Django backend deploys separately to Render — Vercel only builds
# frontend/. Vercel's zero-config Python Functions detector triggers on ANY
# top-level api/ folder + requirements.txt at the repo root, regardless of
# vercel.json's "framework" setting (that field only disables framework
# *preset* detection, not this separate Functions auto-detection). Excluding
# every backend path here stops Vercel from ever seeing those files, so it
# can't misidentify this as a Python project.
accounts/
analytics/
api/
assistant/
catalog/
core/
customers/
inventory/
ml_engine/
mongo/
notifications/
onboarding/
orders/
reports/
smartserve/
staff/
suppliers/
templates/
static/
staticfiles/
media/
_impDocs/
_sample_data_1/
_sample_data_2/

